# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cliente de Prisma: lo regenera el postinstall (prisma generate)
/src/generated/

# Base local y adjuntos de desarrollo
/.local/
/.data/

# Configuración local de Claude Code (puertos de la vista previa)
/.claude/

# Playwright (npm run test:e2e)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Capturas del rediseño: solo se versionan 4 de referencia (docs/diseno.md);
# las demás se regeneran con el arnés de e2e y quedan locales.
/docs/capturas/rediseno/*
!/docs/capturas/rediseno/login-1440.png
!/docs/capturas/rediseno/panel-direccion-1440.png
!/docs/capturas/rediseno/nuevo-formulario-error-1440.png
!/docs/capturas/rediseno/ficha-1440.png
