# /etc/cementeria/backup.env: entorno de cementeria-backup.service
# (scripts/backup.sh). Solo en producción: staging no tiene backup.
#
#   install -o root -g root -m 0600 backup.env.ejemplo /etc/cementeria/backup.env
#
# [SECRETA] = no se comparte. La clave de restic además se custodia FUERA del
# servidor de backup (<CUSTODIO_CLAVE_RESTIC>, pedido A7): sin ella los
# backups no se pueden leer.

# --- pg_dump ------------------------------------------------------------------
# Con qué rol corre el dump está pendiente de acordar con Sistemas (pedido A7).
# Propuesta: cementeria_backup, LOGIN y miembro de pg_read_all_data
# (docs/despliegue.md, "Backups").
PGHOST=HOST_POSTGRES
PGPORT=5432
PGDATABASE=cementeria
PGUSER=cementeria_backup
# [SECRETA]
PGPASSWORD=CAMBIAR_CLAVE_BACKUP
# Verificar el certificado del servidor si PostgreSQL está en otra máquina:
# PGSSLMODE=verify-full

# --- restic -------------------------------------------------------------------
# El destino lo define Sistemas (<SERVIDOR_BACKUP>). Con SFTP, la clave SSH
# del usuario cementeria-backup está en /var/lib/cementeria-backup/.ssh/.
RESTIC_REPOSITORY=sftp:cementeria@SERVIDOR_BACKUP:/backups/cementeria
# Con el servidor REST de restic sería, por ejemplo:
# RESTIC_REPOSITORY=rest:https://SERVIDOR_BACKUP:8000/cementeria
# RESTIC_REST_USERNAME=cementeria
# RESTIC_REST_PASSWORD=[SECRETA]

# [SECRETA] La clave de cifrado del repositorio.
RESTIC_PASSWORD=CAMBIAR_CLAVE_RESTIC

# --- Qué y cuánto -----------------------------------------------------------------
BACKUP_DIR=/var/backups/cementeria
ADJUNTOS_DIR=/var/lib/cementeria/adjuntos
# Propuesta, a confirmar con Asesoría Legal (pedido C2, pregunta 3).
RETENCION_DIARIAS=30
RETENCION_MENSUALES=12
# 0 si el repositorio es append-only y la retención la aplica Sistemas.
RETENCION_EN_ESTE_SERVIDOR=1
