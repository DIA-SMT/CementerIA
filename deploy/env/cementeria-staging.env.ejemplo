# /etc/cementeria-staging/cementeria.env: entorno de STAGING de
# cementeria-staging.service. Mismas reglas que el de producción
# (deploy/env/cementeria.env.ejemplo): 0600 root:root, [SECRETA] = no se comparte.
#
#   install -o root -g root -m 0600 cementeria-staging.env.ejemplo /etc/cementeria-staging/cementeria.env
#
# Staging tiene su propio clúster de PostgreSQL (pedido A2: los roles son
# globales del clúster, así que en el de producción las credenciales serían
# las mismas), sus propias claves y su propio SESSION_SECRET. Solo datos ficticios.

# [SECRETA] cementeria_app del clúster de STAGING.
DATABASE_URL=postgresql://cementeria_app:CAMBIAR_CLAVE_APP_STAGING@HOST_POSTGRES_STAGING:5432/cementeria

# [SECRETA] Distinto del de producción: una cookie de staging no vale en producción.
SESSION_SECRET=CAMBIAR_SECRETO_DE_SESION_STAGING

# Con AUTH_DEV_LOGIN_STAGING tiene que ser https y llevar "staging" en el host.
APP_URL=https://__DOMINIO_STAGING__

ADJUNTOS_DIR=/var/lib/cementeria-staging/adjuntos

# Cidituc con la clave de staging (pedido B1).
CIDITUC_HABILITADO=1
CIDITUC_DERIVADOR_URL=https://cidituc.smt.gob.ar/
CIDITUC_CLAVE=cementeria-staging
CIDITUC_API_URL=https://estadisticas.smt.gob.ar:5000

# Mientras `cementeria-staging` no esté en el derivador: ingreso de prueba
# solo para estos CUIL de la semilla (ficticios), separados por coma. Sacarlo
# cuando Cidituc ande. AUTH_DEV_LOGIN (sin _STAGING) NO va nunca.
# AUTH_DEV_LOGIN_STAGING=20000000001,27000000022

# ADMIN_INICIAL_CUIL=20000000001
