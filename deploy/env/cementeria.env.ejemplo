# /etc/cementeria/cementeria.env: entorno de PRODUCCIÓN de cementeria.service.
#
#   install -o root -g root -m 0600 cementeria.env.ejemplo /etc/cementeria/cementeria.env
#
# 0600 root:root: lo lee systemd al arrancar el servicio, no el usuario
# cementeria. Formato de EnvironmentFile de systemd: CLAVE=valor, sin
# `export`; las comillas son opcionales. Cada variable está explicada en
# .env.example del repositorio; acá van solo las de producción.
#
# [SECRETA] = no se copia a tickets, chats ni correos; se guarda solo acá.
# NODE_ENV, TZ, HOSTNAME y PORT los fija la unidad (deploy/systemd/cementeria.service).

# [SECRETA] Rol cementeria_app (privilegios mínimos). La clave la pone Sistemas
# con \password cementeria_app y se la entrega al responsable por un canal seguro.
DATABASE_URL=postgresql://cementeria_app:CAMBIAR_CLAVE_APP@HOST_POSTGRES:5432/cementeria

# Conexiones del pool (5 por defecto).
# DB_POOL_MAX=5

# [SECRETA] Firma la cookie de sesión. 48 bytes aleatorios, distintos de los de staging:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotarlo cierra todas las sesiones (docs/despliegue.md, "Rotación de SESSION_SECRET").
SESSION_SECRET=CAMBIAR_SECRETO_DE_SESION

# Origen público: base del QR de la carátula. Sin barra final.
APP_URL=https://__DOMINIO_PROD__

# Carpeta de los adjuntos, fuera del webroot. Obligatoria y absoluta; tiene que
# coincidir con ReadWritePaths= de la unidad. (ADJUNTOS_ALMACEN queda sin
# definir: el disco es el valor por defecto; `supabase` es para Vercel,
# docs/despliegue-vercel.md.)
ADJUNTOS_DIR=/var/lib/cementeria/adjuntos

# Cidituc. 1 recién cuando la clave `cementeria` esté desplegada en el
# derivador (pedido B1); con 0 nadie puede ingresar en producción.
CIDITUC_HABILITADO=1
CIDITUC_DERIVADOR_URL=https://cidituc.smt.gob.ar/
CIDITUC_CLAVE=cementeria
CIDITUC_API_URL=https://estadisticas.smt.gob.ar:5000
# Opcional: el intermedio PEM que reemplaza al embebido, sin redesplegar.
# CIDITUC_CA_PEM=

# CUIL del primer administrador (lo usa la semilla de producción, no la app).
# ADMIN_INICIAL_CUIL=

# NUNCA en producción: con cualquiera de estas dos la app no arranca o, peor,
# ofrece entrar sin Cidituc.
# AUTH_DEV_LOGIN
# AUTH_DEV_LOGIN_STAGING
