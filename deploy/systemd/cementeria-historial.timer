# Dispara cementeria-historial.service todas las noches, después del backup de
# las 02:00 y antes del barrido de adjuntos de las 04:30. Va en
# /etc/systemd/system/; se activa con:
#   systemctl enable --now cementeria-historial.timer

[Unit]
Description=CementerIA: verificación nocturna del historial

[Timer]
OnCalendar=*-*-* 03:30:00 America/Argentina/Tucuman
# Si el servidor estaba apagado a esa hora, corre al arrancar.
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
