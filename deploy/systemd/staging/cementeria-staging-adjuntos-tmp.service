# Barrido diario de temporales de adjuntos de STAGING. Igual que el de
# producción (deploy/systemd/cementeria-adjuntos-tmp.service), sobre
# /var/lib/cementeria-staging/adjuntos/tmp/. Lo dispara
# cementeria-staging-adjuntos-tmp.timer. Va en /etc/systemd/system/.
#
# Corre el barrido compilado a JavaScript (scripts/barrer-adjuntos-tmp.mjs,
# lo arma `npm run empaquetar`): en el servidor no hay tsx.
#
# A mano: systemctl start cementeria-staging-adjuntos-tmp

[Unit]
Description=CementerIA STAGING: barrido de temporales de adjuntos
After=local-fs.target

[Service]
Type=oneshot
User=cementeria-staging
Group=cementeria-staging
WorkingDirectory=/opt/cementeria-staging/actual
ExecStart=/usr/bin/node scripts/barrer-adjuntos-tmp.mjs
# Solo lo que necesita: no lee /etc/cementeria-staging/cementeria.env, que tiene
# los secretos de la app.
Environment=NODE_ENV=production
Environment=TZ=America/Argentina/Tucuman
Environment=ADJUNTOS_DIR=/var/lib/cementeria-staging/adjuntos
SyslogIdentifier=cementeria-staging-adjuntos-tmp

ProtectSystem=strict
ReadWritePaths=/var/lib/cementeria-staging/adjuntos
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027
