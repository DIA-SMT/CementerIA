# CementerIA, STAGING (docs/despliegue.md, "Staging"). Va en
# /etc/systemd/system/cementeria-staging.service.
#
# Igual que producción (deploy/systemd/cementeria.service) con su propio
# usuario, código, adjuntos, entorno y puerto: puede compartir la VM con
# producción sin ver nada de ella. Solo datos ficticios. El puerto (3011) es
# una propuesta: tiene que coincidir con deploy/nginx/cementeria-staging.conf
# y con <PUERTO_STAGING> del pedido A1.

[Unit]
Description=CementerIA STAGING (datos ficticios)
Documentation=https://github.com/DIA-SMT/CementerIA/blob/main/docs/despliegue.md
After=network-online.target
Wants=network-online.target
# Con Restart=always, un error de configuración (la app termina con código 1
# si el entorno no sirve, src/lib/arranque.ts) reiniciaría para siempre.
# Después de 5 intentos en 10 minutos la unidad queda en falla y se ve en
# `systemctl --failed`.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=cementeria-staging
Group=cementeria-staging
WorkingDirectory=/opt/cementeria-staging/actual
ExecStart=/usr/bin/node server.js

# Secretos y configuración de la instancia (0600 root:root; ver
# deploy/env/cementeria-staging.env.ejemplo). systemd lo lee como root antes
# de bajar a User=: el usuario cementeria-staging no puede leer el archivo.
EnvironmentFile=/etc/cementeria-staging/cementeria.env
# Lo que no es secreto ni cambia entre instalaciones va acá, a la vista.
Environment=NODE_ENV=production
# La sección 6 pide la zona de Tucumán en el proceso, aunque el código no
# depende de ella (las fechas se formatean con timeZone explícito).
Environment=TZ=America/Argentina/Tucuman
# server.js escucha en HOSTNAME:PORT. Solo en loopback: lo único que llega es nginx.
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3011
Environment=NEXT_TELEMETRY_DISABLED=1

Restart=always
RestartSec=5
# Next termina los requests en curso al recibir SIGTERM (guía de self-hosting).
KillSignal=SIGTERM
TimeoutStopSec=30

# Logs: una línea JSON por evento a la salida estándar (src/lib/log.ts), que
# journald guarda: journalctl -u cementeria-staging -o cat | jq
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cementeria-staging

# --- Endurecimiento ---------------------------------------------------------
# El sistema de archivos es de solo lectura para el servicio, salvo los
# adjuntos y la caché de Next (CacheDirectory= crea /var/cache/cementeria-staging
# con dueño cementeria-staging; deploy/desplegar.sh enlaza ahí .next/cache).
ProtectSystem=strict
ReadWritePaths=/var/lib/cementeria-staging/adjuntos
CacheDirectory=cementeria-staging
CacheDirectoryMode=0700
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# Sin ProcSubset=pid: Node lee /proc/cpuinfo y /proc/stat (os.cpus()).
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
# IPv4/IPv6 para la base y Cidituc; Unix para journald y un posible socket de PostgreSQL.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Una llamada fuera de la lista falla con EPERM en vez de matar el proceso:
# libuv prueba io_uring y, si no puede, sigue sin él.
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute= NO: rompe el compilador JIT de V8.
# Los adjuntos se crean 0440 y sus carpetas 0750 (src/lib/adjuntos/almacen.ts);
# staging no tiene backup (solo datos ficticios).
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
