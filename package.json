{
  "name": "cementeria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integracion": "vitest run --config vitest.integracion.config.mts",
    "test:e2e": "playwright test",
    "db:local": "node scripts/db-local.mjs iniciar",
    "db:local:detener": "node scripts/db-local.mjs detener",
    "db:local:estado": "node scripts/db-local.mjs estado",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "node scripts/db-local.mjs recrear-base && prisma migrate deploy && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "adjuntos:barrer": "tsx scripts/barrer-adjuntos-tmp.ts",
    "empaquetar": "node scripts/empaquetar.mjs",
    "db:verificar-restauracion": "node scripts/verificar-restauracion.mjs",
    "historial:verificar": "tsx scripts/verificar-historial.ts",
    "avisos:generar": "tsx scripts/generar-avisos.ts",
    "avisos:purgar": "tsx scripts/purgar-avisos.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "jose": "6.2.12",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "embedded-postgres": "15.18.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
