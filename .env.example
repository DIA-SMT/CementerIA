# CementerIA: variables de entorno.
#
# Copiá este archivo a .env.local y completalo. .env.local NO se versiona
# (.gitignore ignora .env* salvo este ejemplo). Next lee .env.local solo; la CLI
# de Prisma, los scripts de base y la semilla lo cargan con dotenv.
#
# Solo valores de desarrollo: nunca credenciales de producción ni datos reales.

# --- Base de datos ----------------------------------------------------------
#
# Tres roles (ver docs/propuesta-mvp.md, sección 2 "Roles de base"):
#   cementeria_app     con el que corre la aplicación (SELECT/INSERT/UPDATE acotados)
#   cementeria_deploy  con el que corren las migraciones; al conectarse toma el
#                      rol cementeria_owner, dueño de todos los objetos
#   cementeria_owner   NOLOGIN; nadie se conecta con él
#
# En local, `npm run db:local` levanta PostgreSQL 15 sin instalación en el
# puerto 54329 y les pone a los roles las claves que figuran en estas URLs: si
# cambiás una clave acá, volvé a correr `npm run db:local` para que llegue a la
# base. Usá claves sin caracteres especiales (o escapalas en la URL).

# Runtime de la app: rol cementeria_app.
DATABASE_URL=postgresql://cementeria_app:CAMBIAR_CLAVE_APP@localhost:54329/cementeria

# Migraciones (prisma migrate dev/deploy/status/diff): rol cementeria_deploy.
# En producción esta credencial no queda en el servidor.
MIGRATE_DATABASE_URL=postgresql://cementeria_deploy:CAMBIAR_CLAVE_DEPLOY@localhost:54329/cementeria

# Shadow database de `prisma migrate dev` y `migrate diff --from-migrations`.
# Prisma la vacía en cada uso. La crea scripts/db-init.sql. Si se omite, Prisma
# crea una temporal (el owner tiene CREATEDB en desarrollo).
SHADOW_DATABASE_URL=postgresql://cementeria_deploy:CAMBIAR_CLAVE_DEPLOY@localhost:54329/cementeria_shadow

# Clave del superusuario `postgres` del clúster LOCAL (solo db-local.mjs). Se
# fija al crear el clúster: cambiarla después exige `node scripts/db-local.mjs
# reiniciar-datos`, que borra la base local.
DB_LOCAL_CLAVE_SUPERUSUARIO=CAMBIAR_CLAVE_SUPERUSUARIO

# Tamaño del pool de conexiones de la app (opcional, por defecto 5).
# DB_POOL_MAX=5

# --- Sesión -------------------------------------------------------------------

# Firma la cookie de sesión (JWT HS256). 32 bytes o más, aleatorios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CAMBIAR_SECRETO_DE_SESION

# Login simulado en /dev/login (entrar como cualquier usuario activo, sin
# Cidituc). Solo desarrollo: la app NO ARRANCA en producción con esta variable
# definida, ni siquiera vacía. Por eso NO va en .env.local (que `next start`
# también lee) sino en .env.development.local, que solo lee `next dev`:
#   echo AUTH_DEV_LOGIN=1 > .env.development.local
# AUTH_DEV_LOGIN=1

# Staging sin clave en el derivador: habilita /dev/login solo para la lista
# blanca de CUILs (usuarios semilla, ficticios), separados por coma. En
# producción exige APP_URL con "staging" en el host; con el host de producción
# la app no arranca.
# AUTH_DEV_LOGIN_STAGING=20000000001,27000000022

# Origen público de la instancia. Solo hace falta con AUTH_DEV_LOGIN_STAGING.
# APP_URL=https://cementeria-staging.smt.gob.ar

# CUIL del primer administrador que crea la semilla (11 dígitos, ficticio en
# desarrollo).
# ADMIN_INICIAL_CUIL=20000000001

# --- Cidituc (login municipal) --------------------------------------------------

# Prende la integración. Mientras la clave `cementeria` no esté registrada y
# desplegada en el derivador, queda en 0 y se entra por /dev/login.
CIDITUC_HABILITADO=0

# El derivador (la pantalla de login municipal). Va solo el origen: el
# fragmento #/login?next=<clave>&state=<state> lo arma el código, y si acá se
# escribe uno, se reemplaza. Si alguna vez lleva "#", va ENTRE COMILLAS: sin
# ellas, el resto de la línea se toma como comentario.
CIDITUC_DERIVADOR_URL=https://cidituc.smt.gob.ar/

# Clave de esta instancia en el derivador (APPS_EXTERNAS y RESPALDO_CALLBACK):
# cementeria en producción, cementeria-staging en staging.
CIDITUC_CLAVE=cementeria

# Backend contra el que se valida el token (GET {CIDITUC_API_URL}/usuarios/authStatusIA).
# En producción tiene que ser https.
CIDITUC_API_URL=https://estadisticas.smt.gob.ar:5000

# La URL de retorno NO es una variable de la app: es la que se registra en el
# derivador para la clave de arriba (en local, con el derivador corriendo en
# C:/repo/derivador): http://localhost:3000/auth/callback

# Opcional: certificado intermedio (PEM) que reemplaza al embebido sin
# redesplegar. Vacío = se usa el embebido.
# CIDITUC_CA_PEM=
